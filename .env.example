# Supabase Realtime credentials for online play.
# Copy this file to `.env.local` and fill in values from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# These are PUBLIC client keys (safe to expose in the browser). Online play uses
# only Realtime broadcast/presence channels — no database tables are required.
#
# Leave these unset to develop locally: online mode falls back to a same-browser
# "test mode" (two tabs) so you can try multiplayer without any backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=